/*
 * Hardware del nodo di monitoraggio (gia' pronto: e' configurazione).
 *
 * - alias con nomi "di progetto" per LED e pulsante: nel codice usa
 *   DT_ALIAS(led_allarme), DT_ALIAS(led_battito), DT_ALIAS(pulsante_conferma)
 *   (nel devicetree il trattino diventa underscore nelle macro).
 * - il sensore Bosch BME280 (bus i2c0 = twi0 in Renode, indirizzo 0x76) NON ha un nodo
 *   qui: lo comanda il tuo driver bme280_corso.c (Modulo 6, esercizio 7), che usa
 *   direttamente il bus i2c0, gia' attivo sulla nrf52840dk. Un nodo "bosch,bme280"
 *   attiverebbe il driver ufficiale di Zephyr, che in Renode non funziona
 *   (teoria/07_periferiche_driver.md, sezione 7).
 * - flash simulata in RAM per i settings (vedi modulo7/07_settings/app.overlay):
 *   Renode non simula il controller della flash del nRF52840.
 */

/ {
	aliases {
		led-allarme = &led0;
		led-battito = &led1;
		pulsante-conferma = &button0;
	};

	sim_flash_controller: sim_flash_controller {
		compatible = "zephyr,sim-flash";
		#address-cells = <1>;
		#size-cells = <1>;
		erase-value = <0xff>;

		flash_sim0: flash_sim@0 {
			compatible = "soc-nv-flash";
			reg = <0x00000000 0x8000>;
			erase-block-size = <4096>;
			write-block-size = <4>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				storage_sim: partition@0 {
					label = "storage_sim";
					reg = <0x00000000 0x8000>;
				};
			};
		};
	};

	chosen {
		zephyr,settings-partition = &storage_sim;
	};
};
