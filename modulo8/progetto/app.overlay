/*
 * Hardware del nodo di monitoraggio (gia' pronto: e' configurazione).
 *
 * - alias con nomi "di progetto" per LED e pulsante: nel codice usa
 *   DT_ALIAS(led_allarme), DT_ALIAS(led_battito), DT_ALIAS(pulsante_conferma)
 *   (nel devicetree il trattino diventa underscore nelle macro).
 *     led-allarme       = LED rosso (PD14, led2)
 *     led-battito       = LED verde (PD12, led0)
 *     pulsante-conferma = pulsante utente blu (PA0, sw0)
 * - il sensore di temperatura (ADT7420, nodo "sensore") NON e' qui: lo aggiunge
 *   comune/sensore_sim.overlay, incluso dal CMakeLists.txt. Nel codice:
 *   DEVICE_DT_GET(DT_NODELABEL(sensore)) e la sensor API.
 * - watchdog indipendente IWDG attivato, con l'alias standard watchdog0.
 * - flash simulata in RAM per i settings (vedi modulo7/07_settings/app.overlay).
 */

/ {
	aliases {
		led-allarme = &red_led_5;
		led-battito = &green_led_4;
		pulsante-conferma = &user_button;
		watchdog0 = &iwdg;
	};

	sim_flash_controller: sim_flash_controller {
		compatible = "zephyr,sim-flash";
		#address-cells = <1>;
		#size-cells = <1>;
		erase-value = <0xff>;

		flash_sim0: flash_sim@0 {
			compatible = "soc-nv-flash";
			reg = <0x00000000 0x8000>;
			erase-block-size = <4096>;
			write-block-size = <4>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				storage_sim: partition@0 {
					label = "storage_sim";
					reg = <0x00000000 0x8000>;
				};
			};
		};
	};

	chosen {
		zephyr,settings-partition = &storage_sim;
	};
};

&iwdg {
	status = "okay";
};
