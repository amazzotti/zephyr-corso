/*
 * Flash simulata per Renode (gia' pronta: e' configurazione, non fa parte dell'esercizio).
 *
 * La flash dello STM32F407 e' divisa in settori grandi e diversi tra loro (4 da 16 KB,
 * 1 da 64 KB, 7 da 128 KB) e il devicetree della stm32f4_disco non prevede una
 * partizione per i dati. Per tenere semplice l'esercizio dichiariamo un "chip di flash"
 * finto, gestito dal driver zephyr,sim-flash, che vive in RAM: 32 KB divisi in pagine
 * da 4 KB, scrittura a blocchi di 4 byte.
 *
 * La partizione "storage_sim" e' indicata come partizione dei settings
 * (chosen zephyr,settings-partition): settings e NVS la usano al posto di una
 * partizione della flash vera.
 *
 * Sulla scheda vera si definirebbe invece una partizione in un settore libero della
 * flash (per esempio l'ultimo da 128 KB): il codice in main.c non cambia.
 */

/ {
	sim_flash_controller: sim_flash_controller {
		compatible = "zephyr,sim-flash";
		#address-cells = <1>;
		#size-cells = <1>;
		erase-value = <0xff>;

		flash_sim0: flash_sim@0 {
			compatible = "soc-nv-flash";
			reg = <0x00000000 0x8000>;
			erase-block-size = <4096>;
			write-block-size = <4>;

			partitions {
				compatible = "fixed-partitions";
				#address-cells = <1>;
				#size-cells = <1>;

				storage_sim: partition@0 {
					label = "storage_sim";
					reg = <0x00000000 0x8000>;
				};
			};
		};
	};

	chosen {
		zephyr,settings-partition = &storage_sim;
	};
};
